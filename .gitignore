# Root .gitignore for neraca_lab (monorepo: backend = Spring Boot, frontend = Next.js)
# Project-specific rules also live in backend/.gitignore and frontend/.gitignore

### Environment & secrets ###
.env
.env.*
!.env.example
*.pem
*.key

### OS ###
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

### IDE / editors ###
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

### Logs ###
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

### Java / Maven (backend) ###
target/
*.class
hs_err_pid*

### Node / Next.js (frontend) ###
node_modules/
.next/
out/
coverage/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

### Claude Code local settings ###
.claude/settings.local.json
