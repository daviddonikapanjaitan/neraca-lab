# Copy to .env and fill in. .env is ignored by git and docker.
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731

# Optional overrides (defaults in application.yaml / docker-compose.yaml)
# DB_NAME=neracalab
# DB_USERNAME=neracalab
# DB_PASSWORD=neracalab
# REDIS_PASSWORD=neracalab

# Ingestion (default in application.yaml): jobs each ingestion queue (uploads, prices, RAG PDF / news,
# screening data) runs at the same time
# INGESTION_WORKERS=5
# true: filings of one company are stored one after the other in upload order instead of at the same time
# INGESTION_SAME_COMPANY_IN_ORDER=false
# Full-text extraction (the model maps the text of the whole workbook) when the standard extraction cannot store
# an upload: on / off, after how long it takes over, how long it may run
# INGESTION_FALLBACK_ENABLED=true
# model of the full-text extraction (OpenRouter id); empty = OPENAI_MODEL
# INGESTION_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# OpenRouter providers the ingestion's model calls never use (OpenInference's DeepSeek endpoint loops for 60 s)
# INGESTION_PROVIDER_IGNORE=OpenInference
# INGESTION_FALLBACK_AFTER=3m
# INGESTION_FALLBACK_TIMEOUT=5m

# Daily prices (defaults in application.yaml): yahoo needs no key; eodhd is the paid fallback
# PRICE_PROVIDER=yahoo
# EODHD_API_TOKEN=your-eodhd-token
# PRICE_SCHEDULE_ENABLED=false

# Login (defaults in application.yaml): session length; password of the root user "admin",
# used only when the user is first created (change it afterwards in User Management)
# AUTH_SESSION_TTL=12h
# AUTH_ROOT_PASSWORD=admin

# AI stock screening (defaults in application.yaml): Tavily news search key (empty = no Tavily),
# cost cap per run, daily screening data ETL after the IDX close
# TAVILY_API_KEY=tvly-your-tavily-key
# SCREENING_BUDGET_USD=0.45
# SCREENING_ETL_SCHEDULE_ENABLED=true
# SCREENING_SYNTHESIS_MODEL=anthropic/claude-opus-5.5

# AI analysis of one stock (Screening > Analysis; defaults in application.yaml): cost cap per analysis
# ANALYSIS_BUDGET_USD=0.20

# RAG vector store (defaults in application.yaml): embedding model via OPENAI_BASE_URL with
# OPENAI_API_KEY; it must produce 1536-dimensional vectors (rag_chunk.embedding)
# RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
